# Public site origin (used for canonical URLs, sitemap, Open Graph)
VITE_SITE_URL=https://semiconlabs.com

# Backend API base URL.
#
# LEAVE THIS EMPTY for the static build. The catalog (domains, skills, modules,
# testcases) is served from src/data/catalog-snapshot.json and needs no server.
# The remaining server-backed screens — sign-up, log-in, checkout, dashboard —
# stay in the UI and show "not connected" until an API is pointed at them.
#
# Set it to your API's base to switch those back on, e.g.
#   VITE_API_URL=https://api.example.com
# or `/api` to use the dev proxy below.
VITE_API_URL=
VITE_API_PROXY=http://localhost:4000

# Razorpay public key id (safe to expose on the client)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Google OAuth client id (web application)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
