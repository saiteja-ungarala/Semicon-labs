# Public site origin (used for canonical URLs, sitemap, Open Graph)
VITE_SITE_URL=https://semiconlabs.com

# Backend API base URL. In dev, requests to /api are proxied to VITE_API_PROXY.
VITE_API_URL=/api
VITE_API_PROXY=http://localhost:4000

# Razorpay public key id (safe to expose on the client)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Google OAuth client id (web application)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
